                        <span class="bu_cuisine_loupe_btn"></span>
                    </a>
                    <!--<a href="">
                        <span class="bu_cuisine_photos_btn">&#9658;&nbsp;0 autres photos</span>
                    </a>/-->
                </div>
                                    <p class="bu_cuisine_legende_1">Recette proposée par <a class="author" href="/recette-auteur/8152725-contesetdelices">contesetdelices</a></p>
                                                    <p class="bu_cuisine_legende_italic summary">Un incontournable dans ma cuisine, peut être bientôt dans la vôtre !</p>
                            </div>
            <div class="grid_left w50">
                                    <div class="bu_cuisine_recette_notes">
                        <span class="jStar">
                            <span class="bu_cuisine_ystar"></span><span class="bu_cuisine_ystar"></span><span class="bu_cuisine_ystar"></span><span class="bu_cuisine_ystar"></span><span class="bu_cuisine_ystar"></span>                                                    </span>
                        <span class="review hreview-aggregate">
                            <p class="bu_cuisine_title_notes rating">
                                <span class="average">
                                    <span class="jAverage">
                                        5                                    </span>
                                </span>
                                /
                                <span class="best">5</span>
                                <span class="count">&nbsp;(<span class="jNbNote">8</span> avis)</span>
                            </p>
                        </span>
                    </div>
                                    <p class="bu_cuisine_title_3">Ingrédients / pour <span class="yield">4</span> personnes</p>                <ul class="bu_cuisine_ingredients">
                                            <li class="ingredient">2 belles courgettes</li>

                                            <li class="ingredient">2 petites tomates</li>

                                            <li class="ingredient">1 gros <a href="/encyclopedie/fiche_composant/34/oignon.shtml" class="bu_cuisine_pointille_vert name" alt="Oignon">oignon</a></li>

                                            <li class="ingredient">Huile d'olive</li>

                                            <li class="ingredient"><a href="/encyclopedie/fiche_composant/174/thym.shtml" class="bu_cuisine_pointille_vert name" alt="Thym">thym</a></li>

                                            <li class="ingredient">Sel, <a href="/encyclopedie/fiche_composant/129/poivre.shtml" class="bu_cuisine_pointille_vert name" alt="Poivre">poivre</a></li>

                                            <li class="ingredient">90 g de <a href="/encyclopedie/fiche_composant/289/farine.shtml" class="bu_cuisine_pointille_vert name" alt="Farine">farine</a></li>

                                            <li class="ingredient">75 g de <a href="/encyclopedie/fiche_composant/287/beurre.shtml" class="bu_cuisine_pointille_vert name" alt="Beurre">beurre</a></li>

                                            <li class="ingredient">70 g de <a href="/encyclopedie/fiche_composant/261/parmesan.shtml" class="bu_cuisine_pointille_vert name" alt="Parmesan">parmesan</a></li>

                    
                </ul>
                <div id="ba_x24" class="ba x24"><script>OAS_AD('x24');</script></div>                <p class="bu_cuisine_title_3">Réalisation</span></p>
                <div class="grid_left" style="min-width:110px;">
                    <ul class="bu_cuisine_carnet">
                        <li class="bu_cuisine_picto1">Difficulté</li>
                                                    <li class="bu_cuisine_picto2">Préparation</li>
                                                    <li class="bu_cuisine_picto3">Cuisson</li>
                                                    <li class="bu_cuisine_picto5">Temps Total</li>
                                            </ul>
                </div>
                <div class="grid_last">
                    <ul class="bu_cuisine_carnet_2">
                        <li>Facile</li>
                                                    <li>
                                <span class="duration">20&nbsp;mn<span class="value-title" title="PT20M"></span></span>
                            </li>
                                                    <li>
                                <span>45&nbsp;mn</span>
                            </li>
